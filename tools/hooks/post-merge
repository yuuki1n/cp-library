#!/bin/sh
# マージ（git pull を含む）のあとに VS Code のスニペットを作り直す。
# 有効にするには一度だけ:  git config core.hooksPath tools/hooks
#
# 失敗してもマージ自体は止めない（post-merge の終了値は git が見ない）。

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

if ! command -v python >/dev/null 2>&1; then
  echo "post-merge: python が見つからないのでスニペット生成をとばした" >&2
  exit 0
fi

python tools/gen_snippets.py || echo "post-merge: スニペット生成に失敗した" >&2
exit 0
