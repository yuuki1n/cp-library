#!/bin/sh
# コミットが .hpp を触っていたら VS Code のスニペットを作り直す。
# 有効にするには一度だけ:  git config core.hooksPath tools/hooks
#
# 毎コミットで走るので、ライブラリ本体に関係ないコミット
# （README や tools だけ、テストだけ）では何もしない。

changed=$(git diff-tree --no-commit-id --name-only -r HEAD)
echo "$changed" | grep -q '\.hpp$' || exit 0
echo "$changed" | grep -v '^test/' | grep -q '\.hpp$' || exit 0

. "$(dirname "$0")/_regen_snippets.sh" post-commit
